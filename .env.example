# App
APP_NAME=CogniMente
# development deixa o /docs aberto; em production ele fecha e a SECRET_KEY é obrigatória
APP_ENV=development
SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognimente

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS S3 / Cloudflare R2 (para fotos dos familiares)
S3_BUCKET_NAME=cognimente-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT_URL=  # deixe vazio para AWS, preencha para R2

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Endereço público da API (links das fotos). Em produção, use o domínio real.
PUBLIC_BASE_URL=http://localhost:8000
